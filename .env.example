# ---------------------------------------------------------------------------
# 305 Beverages Co. — Environment Variables
# Copy this file to `.env.local` and fill in values from your Supabase project.
# NEVER commit real secrets. NEVER expose the service-role key to the client.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (used by the Supabase browser client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used ONLY in server code (seeding / admin tasks).
# Must never be imported into a client component. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
